# Example environment variables for CivicGuide AI backend

# Required: Google Gemini API key
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Required: Supabase configuration
# Get from: https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional but recommended for privileged operations
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Optional: Tavily API key for news search
TAVILY_API_KEY=your_tavily_api_key_here

# Model selection
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# App environment
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
